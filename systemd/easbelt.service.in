@GENERATED_SCRIPT_FILE_WARNING@

[Unit]
Description=EasPanel file conveyor service
After=network.target remote-fs.target nss-lookup.target sound.target

[Service]
LimitNOFILE=4096
Type=simple
ExecStart=@prefix@/sbin/easbelt
PrivateTmp=true
Restart=always
RestartSec=2
StartLimitInterval=120
StartLimitBurst=50

[Install]
WantedBy=multi-user.target
