# So python bytecompilation works correctly
%define __python @PYTHON@

Summary: Emergency Management Control Applet for DASDAQ/Rivendell
Name: easpanel
Version: @VERSION@
Release: @RPM_RELEASE@%{?dist}
License: GPLv2
Packager: Fred Gleason <fredg@paravelsystems.com>
Source: %{name}-@VERSION@.tar.gz
BuildRequires: qt5-qtbase-devel
BuildRoot: /var/tmp/%{name}-@VERSION@


%description
EASPanel is a control applet for sending Emergency Alert System (EAS)
alerts generated by a DASDAQ EAS generator to Rivendell.


%package belt
Summary: Conveyor belt service for distributing files

%description belt
This package provides the easbelt(8) service, which can be used to
automate the distribution of files in a one-to-many fashion.


%package pypad
Summary: Rivendell PyPAD Script for EASPanel


%description pypad
Provides a Rivendell PyPAD Script for EASPanel


%prep


%setup


%build
%configure
make


%install
rm -rf $RPM_BUILD_ROOT
make install DESTDIR=$RPM_BUILD_ROOT
mkdir -p $RPM_BUILD_ROOT/usr/lib/easpanel
cp conf/easpanel-sample.conf $RPM_BUILD_ROOT/usr/lib/easpanel/
mkdir -p $RPM_BUILD_ROOT/usr/lib/easpanel-belt
cp conf/easpanel-sample.conf $RPM_BUILD_ROOT/usr/lib/easpanel-belt/


%post
if test ! -e /etc/easpanel.conf ; then
  cp /usr/lib/%{name}/easpanel-sample.conf /etc/easpanel.conf
fi
if [ -x %{_bindir}/gtk-update-icon-cache ] ; then
  %{_bindir}/gtk-update-icon-cache -f --quiet %{_datadir}/icons/hicolor || :
fi
mkdir -p /var/eas
chmod 0777 /var/eas


%clean
rm -rf $RPM_BUILD_ROOT


%files
%defattr(-,root,root)
%{_bindir}/easp
%{_bindir}/directp
%{_datadir}/applications/com.paravelsystems.easpanel.desktop
%{_datadir}/applications/com.paravelsystems.easpanel-directp.desktop
%{_datadir}/easpanel/attention.wav
%{_datadir}/icons/hicolor/16x16/apps/easpanel.png
%{_datadir}/icons/hicolor/22x22/apps/easpanel.png
%{_datadir}/icons/hicolor/32x32/apps/easpanel.png
%{_datadir}/icons/hicolor/48x48/apps/easpanel.png
/usr/lib/easpanel/easpanel-sample.conf
%doc AUTHORS
%doc ChangeLog
%doc COPYING 
%doc NEWS 
%doc README 


%files belt
%{_sbindir}/easbelt
/lib/systemd/system/easbelt.service
/usr/lib/easpanel-belt/easpanel-sample.conf
%doc AUTHORS
%doc ChangeLog
%doc COPYING 
%doc NEWS 
%doc README 


%post belt
if test ! -e /etc/easpanel.conf ; then
  cp /usr/lib/%{name}-belt/easpanel-sample.conf /etc/easpanel.conf
fi
/bin/systemctl daemon-reload
/bin/systemctl restart easbelt.service
/bin/systemctl enable easbelt.service

%preun belt
/bin/systemctl stop easbelt.service
/bin/systemctl disable easbelt.service

%postun belt
/bin/systemctl daemon-reload


%files pypad
%{_libdir}/rivendell/pypad/pypad_easpanel.py
%{_libdir}/rivendell/pypad/pypad_easpanel.exemplar
%{_libdir}/rivendell/pypad/__pycache__/pypad_easpanel.*


