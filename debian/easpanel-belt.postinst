#!/bin/sh
# postinst script for easpanel

case "$1" in
    configure)
      ldconfig
      if test ! -e /etc/easpanel.conf ; then
        cp /usr/share/easpanel-belt/easpanel-sample.conf /etc/easpanel.conf
      fi
      /bin/systemctl daemon-reload
      /bin/systemctl restart easbelt
      /bin/systemctl enable easbelt
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
