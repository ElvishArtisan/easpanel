#!/bin/sh
# postinst script for easpanel

case "$1" in
    configure)
      ldconfig
      if [ -x %{_bindir}/gtk-update-icon-cache ] ; then
	/usr/bin/gtk-update-icon-cache -f --quiet /usr/share/icons/hicolor || :
      fi
      if test ! -e /etc/easpanel/easp.conf ; then
	mkdir -p /etc/easpanel
        cp /usr/share/easpanel/easp-sample.conf /etc/easpanel/easp.conf
      fi
      if test ! -e /etc/easpanel/directp.conf ; then
	mkdir -p /etc/easpanel
        cp /usr/share/easpanel/directp-sample.conf /etc/easpanel/directp.conf
      fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
